        </properties>
      </component>
      <component id="btn_remove" class="javax.swing.JButton" binding="btnRemoverEquipamento">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
