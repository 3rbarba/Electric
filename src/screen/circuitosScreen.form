<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="screen.circuitosScreen">
  <grid id="root" binding="main" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="14" left="14" bottom="12" right="14"/>
    <constraints>
      <xy x="20" y="20" width="1050" height="650"/>
    </constraints>
    <properties>
      <background color="-15656921"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="panelQuadro_id" binding="panelQuadro" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="12" left="12" bottom="10" right="12"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-14735049"/>
        </properties>
        <border type="line" title="QUADRO DE CARGAS E DIVISÃO DE CIRCUITOS" title-justification="2">
          <title-color color="-1710101"/>
        </border>
        <children>
          <grid id="panelConfiguracao_id" binding="panelConfiguracao" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="4" vgap="2">
            <margin top="4" left="4" bottom="4" right="4"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14735049"/>
            </properties>
            <border type="line" title="CONFIGURAÇÃO DOS CIRCUITOS" title-justification="2">
              <title-color color="-1710101"/>
            </border>
            <children>
              <grid id="panelSeletores_id" binding="panelSeletores" layout-manager="GridLayoutManager" row-count="2" column-count="6" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="2">
                <margin top="2" left="4" bottom="2" right="4"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-14735049"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="lblSistema" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <foreground color="-1710101"/>
                      <text value="Sistema:"/>
                    </properties>
                  </component>
                  <component id="comboSistema_id" class="javax.swing.JComboBox" binding="comboSistema">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <background color="-15656921"/>
                      <foreground color="-1710101"/>
                    </properties>
                  </component>
                  <component id="lblTensao" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <foreground color="-1710101"/>
                      <text value="Tensão (V):"/>
                    </properties>
                  </component>
                  <component id="comboTensao_id" class="javax.swing.JComboBox" binding="comboTensao">
                    <constraints>
                      <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <background color="-15656921"/>
                      <foreground color="-1710101"/>
                    </properties>
                  </component>
                  <component id="lblMetodo" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <foreground color="-1710101"/>
                      <text value="Método:"/>
                    </properties>
                  </component>
                  <component id="comboMetodo_id" class="javax.swing.JComboBox" binding="comboMetodo">
                    <constraints>
                      <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <background color="-15656921"/>
                      <foreground color="-1710101"/>
                    </properties>
                  </component>
                  <component id="lblFca" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <foreground color="-1710101"/>
                      <text value="FCA:"/>
                    </properties>
                  </component>
                  <component id="campoFca_id" class="javax.swing.JTextField" binding="campoFca">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="55" height="-1"/>
                      </grid>
                    </constraints>
                    <properties>
                      <background color="-15656921"/>
                      <foreground color="-1710101"/>
                      <text value="1,00"/>
                    </properties>
                  </component>
                  <component id="lblFct" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <foreground color="-1710101"/>
                      <text value="FCT:"/>
                    </properties>
                  </component>
                  <component id="campoFct_id" class="javax.swing.JTextField" binding="campoFct">
                    <constraints>
                      <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="55" height="-1"/>
                      </grid>
                    </constraints>
                    <properties>
                      <background color="-15656921"/>
                      <foreground color="-1710101"/>
                      <text value="1,00"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="panelAcoes_id" binding="panelAcoes" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="2">
                <margin top="2" left="4" bottom="2" right="4"/>
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-14735049"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="btnAplicarSelecionados_id" class="javax.swing.JButton" binding="btnAplicarSelecionados">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <background color="-15763858"/>
                      <font name="Dialog" size="12" style="1"/>
                      <foreground color="-1710101"/>
                      <requestFocusEnabled value="false"/>
                      <text value="Aplicar Selecionados"/>
                    </properties>
                  </component>
                  <component id="btnAplicarTodos_id" class="javax.swing.JButton" binding="btnAplicarTodos">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <background color="-15763858"/>
                      <font name="Dialog" size="12" style="1"/>
                      <foreground color="-1710101"/>
                      <requestFocusEnabled value="false"/>
                      <text value="Aplicar para Todos"/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
          <scrollpane id="scrollTabela_id" binding="scrollTabela">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14735049"/>
              <horizontalScrollBarPolicy value="30"/>
              <verticalScrollBarPolicy value="20"/>
            </properties>
            <border type="line"/>
            <children>
              <component id="tabela_id" class="javax.swing.JTable" binding="tabela">
                <constraints/>
                <properties>
                  <background color="-14735049"/>
                  <font name="Dialog" size="14"/>
                  <foreground color="-1710101"/>
                  <selectionBackground color="-15763858"/>
                  <selectionForeground color="-1710101"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <grid id="panelRodape_id" binding="panelRodape" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="2">
            <margin top="2" left="4" bottom="2" right="4"/>
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14735049"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="legenda_id" class="javax.swing.JLabel" binding="legenda">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Dialog" size="11"/>
                  <foreground color="-1710101"/>
                  <text value="&lt;html&gt;Ip = Corrente de projeto | Ic = Corrente corrigida | Iz = Corrente máxima do cabo&lt;br&gt;Disj = Disjuntor | S (mm²) = Seção do cabo | Pot. Inst. = Potência instalada&lt;/html&gt;"/>
                </properties>
              </component>
              <component id="btnAnterior_id" class="javax.swing.JButton" binding="btnAnterior">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-13418155"/>
                  <font name="Dialog" size="12" style="1"/>
                  <foreground color="-1710101"/>
                  <requestFocusEnabled value="false"/>
                  <text value="Anterior"/>
                </properties>
              </component>
              <component id="btnExportar_id" class="javax.swing.JButton" binding="btnExportar">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-15763858"/>
                  <font name="Dialog" size="12" style="1"/>
                  <foreground color="-1710101"/>
                  <requestFocusEnabled value="false"/>
                  <text value="Exportar memorial (TXT)"/>
                </properties>
              </component>
              <component id="btnImprimir_id" class="javax.swing.JButton" binding="btnImprimir">
                <constraints>
                  <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-15763858"/>
                  <font name="Dialog" size="12" style="1"/>
                  <foreground color="-1710101"/>
                  <requestFocusEnabled value="false"/>
                  <text value="Imprimir"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
